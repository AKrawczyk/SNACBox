{
	"luci-app-adguardhome": {
		"description": "Grant permissions for the AdGuard Home LuCI app",
		"read": {
			"ubus": {
				"luci.adguardhome": [
					"get_config",
					"get_status",
					"get_statistics",
					"set_passwd"
				]
			},
			"uci": [
				"adguardhome"
			],
			"file": {
				"/usr/libexec/logread-ubox -e AdGuardHome": [
					"stat",
          				"exec"
        			],
				"/sbin/logread -e AdGuardHome": [
					"exec"
				]
			},
			"menu": [
				"admin/snac",
				"admin/snac/adguardhome",
				"admin/snac/adguardhome/*"
			]
		},
		"write": {
			"uci": [
				"adguardhome"
			]
		}
	}
}
