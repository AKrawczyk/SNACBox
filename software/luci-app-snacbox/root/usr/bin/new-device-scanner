#!/bin/sh

LEASES_FILE=/tmp/dhcp.leases
SCAN_INTERVAL=30

set -f

log_message() {
	logger -t new-device-scanner "$1"
}

firewall_sections() {
	uci -q show firewall | sed -n \
		-e 's/^firewall\.\(.*\)=rule$/rule:\1/p' \
		-e 's/^firewall\.\(.*\)=redirect$/redirect:\1/p'
}

mac_is_registered() {
	for section_info in $(firewall_sections); do
		section=${section_info#*:}
		entries=$(uci -q get "firewall.$section.src_mac" 2>/dev/null) || continue
		for entry in $entries; do
			entry=$(printf '%s' "$entry" | tr 'A-F' 'a-f')
			[ "$entry" = "$1" ] && return 0
		done
	done
	return 1
}

while :; do
	changed=0

	if [ -r "$LEASES_FILE" ]; then
		while read -r expiry mac ip hostname client_id; do
			[ -n "${mac:-}" ] || continue
			printf '%s\n' "$mac" | grep -Eiq '^[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}$' || continue
			mac=$(printf '%s' "$mac" | tr 'A-F' 'a-f')

			mac_is_registered "$mac" && continue

			for section_info in $(firewall_sections); do
				case "$section_info" in
					redirect:*) section=${section_info#*:} ;;
					*) continue ;;
				esac

				name=$(uci -q get "firewall.$section.name" 2>/dev/null) || continue
				case "$name" in
					none*) ;;
					*) continue ;;
				esac

				if uci add_list "firewall.$section.src_mac=$mac"; then
					changed=1
					log_message "Added $mac to firewall redirect $name"
				fi
			done
		done < "$LEASES_FILE"
	fi

	if [ "$changed" -eq 1 ]; then
		if uci commit firewall; then
			/etc/init.d/firewall reload
		else
			log_message 'Failed to commit firewall changes'
		fi
	fi

	sleep "$SCAN_INTERVAL"
done