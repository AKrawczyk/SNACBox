#!/bin/sh
set -e

uci set network.wan.proto=dhcp
uci -q delete network.wan.ipaddr || true
uci -q delete network.wan.netmask || true
uci -q delete network.wan.gateway || true
uci -q delete network.wan.dns || true
uci commit network
cp /etc/webguard/99-WAN-DHCP-Static.sh /etc/uci-default/99-WAN-DHCP-Static.sh
chmod +x /etc/uci-default/99-WAN-DHCP-Static.sh