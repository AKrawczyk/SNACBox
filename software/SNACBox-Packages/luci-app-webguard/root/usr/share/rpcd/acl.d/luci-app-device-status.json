{
	"luci-app-device-status": {
		"description": "Grant access to web-rated-device layouts and configurations",
		"read": {
			"file": {
				"/tmp/dhcp.leases": [ "read" ],
				"/www/html/web-rated-device.json": [ "read" ],
				"/usr/bin/web-rated-docker.json": [ "read" ]
			},
			"uci": [ "firewall", "network", "webguard" ],
			"menu": [
				"admin/snac/webguard",
				"admin/snac/webguard/*"
			]
		},
		"write": {
			"file": {
				"/www/html/web-rated-device.json": [ "write" ],
				"/usr/bin/webguard-wan-reset": [ "exec" ],
				"/usr/bin/webguard-factory-reset": [ "exec" ],
				"/etc/webguard/99-WAN-DHCP-Static.sh": [ "exec" ]
			},
			"uci": [ "firewall", "webguard" ]
		}
	}
}
